{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scan2plan.local/schema/config.schema.json",
  "title": "scan2plan configuration (interface I4)",
  "description": "Runtime configuration. Mirrors docs/plans/01-shared-conventions-and-interfaces.md §8.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "tier": {
      "description": "Input tier; auto infers from the capture bundle.",
      "enum": ["auto", "photos", "video", "lidar"],
      "default": "auto"
    },
    "seed": {
      "description": "Determinism seed for all stochastic steps.",
      "type": "integer",
      "default": 1337
    },
    "depth_scale_m": {
      "description": "Metres per depth unit. Seed PNGs are uint16 and hypothesised millimetres (see task B-0).",
      "type": "number",
      "exclusiveMinimum": 0,
      "default": 0.001
    },
    "units": {
      "enum": ["m"],
      "default": "m"
    },
    "output_dir": {
      "type": "string",
      "minLength": 1,
      "default": "out"
    },
    "cache": {
      "type": "boolean",
      "default": true
    },
    "loop_closure": {
      "description": "Enable drift correction (loop closure + pose-graph). Toggled off by `scan2plan ablate`.",
      "type": "boolean",
      "default": true
    },
    "calibration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model": { "enum": ["conformal", "analytic"], "default": "conformal" },
        "nominal": { "type": "number", "exclusiveMinimum": 0, "maximum": 1, "default": 0.9 }
      }
    },
    "outline": {
      "description": "Three-stage room-outline thresholds (plan 04i). Every number that decides a measurement lives here.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "confidence_min": { "type": "integer", "minimum": 0, "maximum": 2, "default": 1 },
        "max_range_m": { "type": "number", "exclusiveMinimum": 0, "default": 8.0 },
        "cell_m": { "type": "number", "exclusiveMinimum": 0, "default": 0.02 },
        "height_bins": { "type": "integer", "minimum": 1, "default": 10 },
        "min_height_bins": { "type": "integer", "minimum": 1, "default": 4 },
        "wall_min_m": { "type": "number", "minimum": 0, "default": 0.25 },
        "wall_max_m": { "type": "number", "exclusiveMinimum": 0, "default": 1.9 },
        "peak_smooth": { "type": "integer", "minimum": 1, "default": 5 },
        "min_peak_frac": { "type": "number", "exclusiveMinimum": 0, "maximum": 1, "default": 0.15 },
        "cam_margin_m": { "type": "number", "minimum": 0, "default": 0.1 },
        "min_run_m": { "type": "number", "exclusiveMinimum": 0, "default": 1.2 },
        "run_gap_m": { "type": "number", "minimum": 0, "default": 0.1 },
        "furniture_max_m": { "type": "number", "exclusiveMinimum": 0, "default": 1.0 },
        "occluder_inset_m": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" }, "default": [0.3, 0.7] },
        "min_step_m": { "type": "number", "exclusiveMinimum": 0, "default": 0.3 },
        "max_edges": { "type": "integer", "minimum": 4, "default": 8 },
        "snap_deg": { "type": "number", "exclusiveMinimum": 0, "default": 8.0 },
        "odometry_ci_frac": { "type": "number", "minimum": 0, "default": 0.01 },
        "weak_coverage_frac": { "type": "number", "exclusiveMinimum": 0, "maximum": 1, "default": 0.5 },
        "occluded_ci_scale": { "type": "number", "minimum": 1, "default": 2.0 },
        "bootstrap_n": { "type": "integer", "minimum": 0, "default": 200 }
      }
    }
  }
}
