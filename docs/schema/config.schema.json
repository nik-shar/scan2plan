{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scan2plan.local/schema/config.schema.json",
  "title": "scan2plan configuration (interface I4)",
  "description": "Runtime configuration. Mirrors docs/plans/01-shared-conventions-and-interfaces.md §8.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "tier": {
      "description": "Input tier; auto infers from the capture bundle.",
      "enum": ["auto", "photos", "video", "lidar"],
      "default": "auto"
    },
    "seed": {
      "description": "Determinism seed for all stochastic steps.",
      "type": "integer",
      "default": 1337
    },
    "depth_scale_m": {
      "description": "Metres per depth unit. Seed PNGs are uint16 and hypothesised millimetres (see task B-0).",
      "type": "number",
      "exclusiveMinimum": 0,
      "default": 0.001
    },
    "units": {
      "enum": ["m"],
      "default": "m"
    },
    "output_dir": {
      "type": "string",
      "minLength": 1,
      "default": "out"
    },
    "cache": {
      "type": "boolean",
      "default": true
    },
    "loop_closure": {
      "description": "Enable drift correction (loop closure + pose-graph). Toggled off by `scan2plan ablate`.",
      "type": "boolean",
      "default": true
    },
    "calibration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model": { "enum": ["conformal", "analytic"], "default": "conformal" },
        "nominal": { "type": "number", "exclusiveMinimum": 0, "maximum": 1, "default": 0.9 }
      }
    },
    "outline": {
      "description": "Three-stage room-outline thresholds (plan 04i). Every number that decides a measurement lives here.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "confidence_min": { "type": "integer", "minimum": 0, "maximum": 2, "default": 1 },
        "max_range_m": { "type": "number", "exclusiveMinimum": 0, "default": 8.0 },
        "cell_m": { "type": "number", "exclusiveMinimum": 0, "default": 0.02 },
        "height_bins": { "type": "integer", "minimum": 1, "default": 10 },
        "min_height_bins": { "type": "integer", "minimum": 1, "default": 4 },
        "wall_min_m": { "type": "number", "minimum": 0, "default": 0.25 },
        "wall_max_m": { "type": "number", "exclusiveMinimum": 0, "default": 1.9 },
        "peak_smooth": { "type": "integer", "minimum": 1, "default": 5 },
        "min_peak_frac": { "type": "number", "exclusiveMinimum": 0, "maximum": 1, "default": 0.15 },
        "cam_margin_m": { "type": "number", "minimum": 0, "default": 0.1 },
        "min_run_m": { "type": "number", "exclusiveMinimum": 0, "default": 1.2 },
        "run_gap_m": { "type": "number", "minimum": 0, "default": 0.1 },
        "merge_tol_m": { "type": "number", "minimum": 0, "default": 0.25 },
        "join_tol_m": { "type": "number", "exclusiveMinimum": 0, "default": 0.3 },
        "evidence_tol_m": { "type": "number", "exclusiveMinimum": 0, "default": 0.05 },
        "collinear_tol_m": { "type": "number", "minimum": 0, "default": 0.15 },
        "occ_band_m": { "type": "number", "exclusiveMinimum": 0, "default": 0.8 },
        "occ_min_cells": { "type": "integer", "minimum": 1, "default": 40 },
        "dropout_max_m": { "type": "number", "exclusiveMinimum": 0, "default": 0.3 },
        "max_extend_m": { "type": "number", "exclusiveMinimum": 0, "default": 1.0 },
        "perp_tol_m": { "type": "number", "exclusiveMinimum": 0, "default": 0.1 },
        "ci_base_m": { "type": "number", "minimum": 0, "default": 0.03 },
        "ci_per_m": { "type": "number", "minimum": 0, "default": 0.15 },
        "open_min_m": { "type": "number", "exclusiveMinimum": 0, "default": 0.5 },
        "open_max_m": { "type": "number", "exclusiveMinimum": 0, "default": 2.5 },
        "blob_bin_m": { "type": "number", "exclusiveMinimum": 0, "default": 0.1 },
        "blob_min_cells": { "type": "integer", "minimum": 1, "default": 6 },
        "node_tol_m": { "type": "number", "exclusiveMinimum": 0, "default": 0.05 },
        "node_merge_m": { "type": "number", "exclusiveMinimum": 0, "default": 0.1 },
        "furniture_max_m": { "type": "number", "exclusiveMinimum": 0, "default": 1.0 },
        "occluder_inset_m": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" }, "default": [0.3, 0.7] },
        "evidence_bin_m": { "type": "number", "exclusiveMinimum": 0, "default": 0.1 },
        "floor_band_m": { "type": "number", "exclusiveMinimum": 0, "default": 0.08 },
        "ray_carve": { "type": "boolean", "default": false },
        "free_stride": { "type": "integer", "minimum": 1, "default": 25 },
        "save_unfiltered": { "type": "boolean", "default": true },
        "min_step_m": { "type": "number", "exclusiveMinimum": 0, "default": 0.3 },
        "max_edges": { "type": "integer", "minimum": 4, "default": 8 },
        "snap_deg": { "type": "number", "exclusiveMinimum": 0, "default": 8.0 },
        "infer_tol_m": { "type": "number", "exclusiveMinimum": 0, "default": 0.2 },
        "inferred_ci_per_m": { "type": "number", "minimum": 0, "default": 0.05 },
        "assert_camera_inside": { "type": "boolean", "default": false },
        "odometry_ci_frac": { "type": "number", "minimum": 0, "default": 0.01 },
        "weak_coverage_frac": { "type": "number", "exclusiveMinimum": 0, "maximum": 1, "default": 0.5 },
        "occluded_ci_scale": { "type": "number", "minimum": 1, "default": 2.0 },
        "bootstrap_n": { "type": "integer", "minimum": 0, "default": 200 },
        "closure_max_m": { "type": "number", "exclusiveMinimum": 0, "default": 2.5 },
        "closure_wall_tol_m": { "type": "number", "exclusiveMinimum": 0, "default": 0.05 },
        "closure_bonus_m": { "type": "number", "minimum": 0, "default": 1.0 },
        "closure_floor_penalty": { "type": "number", "minimum": 0, "default": 1.0 },
        "waist_min_m": { "type": "number", "exclusiveMinimum": 0, "default": 0.6 },
        "waist_max_m": { "type": "number", "exclusiveMinimum": 0, "default": 2.5 },
        "room_grid_m": { "type": "number", "exclusiveMinimum": 0, "default": 0.02 },
        "room_min_area_m2": { "type": "number", "exclusiveMinimum": 0, "default": 0.5 },
        "mc_samples": { "type": "integer", "minimum": 0, "default": 500 },
        "ceiling_min_above_floor_m": { "type": "number", "exclusiveMinimum": 0, "default": 2.0 },
        "ceiling_bin_m": { "type": "number", "exclusiveMinimum": 0, "default": 0.02 },
        "ceiling_prior_low_m": { "type": "number", "exclusiveMinimum": 0, "default": 2.4 },
        "ceiling_prior_high_m": { "type": "number", "exclusiveMinimum": 0, "default": 2.7 },
        "min_room_area_m2": { "type": "number", "exclusiveMinimum": 0, "default": 2.0 },
        "min_room_inradius_m": { "type": "number", "minimum": 0, "default": 0.6 },
        "coverage_min": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.95 },
        "ceiling_min_cells": { "type": "integer", "minimum": 1, "default": 200 },
        "ceiling_min_footprint_frac": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.2 },
        "ceiling_height_low_m": { "type": "number", "exclusiveMinimum": 0, "default": 2.1 },
        "ceiling_height_high_m": { "type": "number", "exclusiveMinimum": 0, "default": 4.0 },
        "ceiling_spread_max_m": { "type": "number", "minimum": 0, "default": 0.3 },
        "ceiling_global_tol_m": { "type": "number", "minimum": 0, "default": 0.3 },
        "overlap_tol_m2": { "type": "number", "minimum": 0, "default": 0.0001 }
      }
    }
  }
}
